# NutriCHAT — API key template
#
# Copy to .env and fill in your API keys
# All non-sensitive settings live in config/*.yaml

# SiliconFlow
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek (official API)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Cloud (DashScope)
ALIYUN_API_KEY=sk-your-key-here
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Volcano Engine (Doubao)
HUOSHAN_API_KEY=ark-your-key-here
HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Tencent Hunyuan
HUNYUAN_API_KEY=sk-your-key-here
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
